{
  "name": "v2",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint .",
    "test:e2e": "playwright install && playwright test",
    "test:e2e:dev": "PLAYWRIGHT_DEV_SERVER=1 playwright test",
    "test": "npm run test:e2e"
  },
  "dependencies": {
    "@nozbe/microfuzz": "1.0.0",
    "culori": "^4.0.2",
    "leader-line": "^1.0.8",
    "lodash": "^4.18.1",
    "lodash-es": "^4.18.1",
    "reinvented-color-wheel": "^0.4.0",
    "svrollbar": "^0.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@inlang/paraglide-js": "^2.18.2",
    "@playwright/test": "^1.60.0",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/color": "3.0.2",
    "@types/culori": "^4.0.1",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24",
    "eslint": "^10.4.1",
    "eslint-plugin-svelte": "^3.19.0",
    "globals": "^17.6.0",
    "mdsvex": "^0.12.7",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "sass-embedded": "^1.105.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.3.0"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
